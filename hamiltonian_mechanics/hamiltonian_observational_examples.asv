% convert to EpochTT, one at a time
time_event = cell(numel(utc_list),1);
for i = 1:numel(utc_list)
  time_event{i} = irf_time(utc_list{i},'utc>EpochTT');
end
iEv = 9;
tint = time_event{iEv} + 30*[-1 1];
time_xline = time_event{iEv};

if 0
