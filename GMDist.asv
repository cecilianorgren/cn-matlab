classdef GMDist
  % POPFIT Gaussian-mixture description of velocity distributions, for
  %   identifying plasma populations.
  %
  %   The basic input is a {nT x nK} cell of gmdistribution objects (one
  %   column per number of components K). Particle data is an optional
  %   companion.
  %
  %   Construction:
  %     gd = GMDist(gmmCell)                      % the basics
  %     gd = GMDist(gmmCell,'time',t,'mass',m)    % metadata
  %     gd = GMDist(gmmCell,'data',mp)            % companion data (see below)
  %     gd = GMDist.fit(mp,K,'start','previous')  % run the fits
  %
  %   Works from gmmCell alone: BIC (if the fits carry it), kneeK,
  %   sortBy, merge, total_covariance, l2err, populations (proportion, V,
  %   T), cold, marginal, plotBIC,
  %   plotComponents, plotSlice (GMM part), and the time-series outputs
  %   tsProp, tsN, tsV, tsT, tsBIC, tsReduced, tsSkymap and plotReduced (these need
  %   time as a GenericTimeArray).
  %   Needs companion data: density per component (unless 'n' is given to
  %   populations), particle overlays in plotSlice, BIC for fits that
  %   carry none.
  %
  %   Companion data is a [N x 3] matrix, a {nT x 1} cell of [N x 3]
  %   (velocities in km/s), or an object with methods samples(it) and
  %   length, optionally a property time, a property mass and a method n
  %   (a time series of total density in cm^-3). MParts is such an object,
  %   but GMDist does not depend on it.
  %
  %   Velocities are in km/s and temperatures in eV.
  %
  %   See also MPARTS, FITGMDIST, GMDISTRIBUTION

  properties (SetAccess = protected)
    gmm     % {nT x nK} gmdistribution ([] where a fit failed)
    %K       % [1 x nK] number of components of each column
    bic     % [nT x nK]
    frac    % [nT x nK] share of the total density carried by each fit (1 for a fit; < 1 for a sub-mixture)
    time    % GenericTimeArray or numeric [nT x 1], [] if unknown
    %mass    % particle mass [kg], [] if unknown
    data    % companion data, [] if none
    options % options used by GMDist.fit
    misc
  end

  properties (Access = protected)
    mass_
  end

  methods
    function obj = GMDist(gmmCell,varargin)
      if nargin < 1 || ~iscell(gmmCell) || ndims(gmmCell) > 2
        error('GMDist:input','GMDist requires a {nT x nK} cell of gmdistribution objects.')
      end
      p = inputParser;
      addParameter(p,'time',[]);
      addParameter(p,'mass',[]);
      addParameter(p,'data',[]);
      addParameter(p,'bic',[]);
      addParameter(p,'options',struct());
      addParameter(p,'frac',[]);
      parse(p,varargin{:});

      [nT,nK] = size(gmmCell);
      isG = cellfun(@(g) isempty(g) || isa(g,'gmdistribution'),gmmCell);
      if ~all(isG(:))
        error('GMDist:input','gmmCell must hold gmdistribution objects ([] for failed fits).')
      end

      data = p.Results.data;
      if isnumeric(data) && ~isempty(data), data = {data}; end
      if ~isempty(data) && ~iscell(data), GMDist.checkCompanion_(data); end
      t = p.Results.time;
      if ~isempty(t) && GMDist.lengthOf_(t) ~= nT
        error('GMDist:input','time must have %d elements.',nT)
      end
      if ~isempty(data) && GMDist.lengthOf_(data) ~= nT
        error('GMDist:input','data must have %d time steps.',nT)
      end

      obj.gmm = gmmCell;
      obj.time = t;
      obj.mass_ = p.Results.mass;
      obj.data = data;
      obj.options = p.Results.options;
      F = p.Results.frac;
      if isempty(F), F = ones(nT,nK); end
      if ~isequal(size(F),[nT,nK])
        error('GMDist:input','frac must be [%d x %d].',nT,nK)
      end
      obj.frac = F;

      % BIC: given, else from the fits, else recomputed from the data
      B = p.Results.bic;
      if isempty(B)
        B = nan(nT,nK);
        for iK = 1:nK
          for it = 1:nT
            g = gmmCell{it,iK};
            if isempty(g), continue, end
            b = GMDist.ownBIC_(g);
            if isnan(b) && ~isempty(data)
              b = GMDist.bicFromSamples_(g,GMDist.getSamples_(data,it));
            end
            B(it,iK) = b;
          end
        end
        missing = isnan(B) & ~cellfun(@isempty,gmmCell);
        if any(missing(:))
          warning('GMDist:bic','BIC is missing for some fits; give ''data'' or ''bic''.')
        end
      elseif ~isequal(size(B),[nT,nK])
        error('GMDist:input','bic must be [%d x %d].',nT,nK)
      end
      obj.bic = B;
    end

    function DB = addToDatabase(obj,db,varargin)
      p = inputParser;
      addParameter(p,'entry','add');
      parse(p,varargin{:});

    end
    
    function nComp = tsNComp(obj)
      nComp = obj.nComp;
      nComp = irf.ts_scalar(obj.time,nComp);
      nComp.userData.specrec.f_label = 'nComp';
      nComp.userData.specrec.p_label = 'nComp';
    end

    function nComp = nComp(obj)
      ne = ~cellfun(@isempty,obj.gmm);  % not empty gmm cells
      nComp = nan(size(obj.gmm));       % initialize empty cell
      nComp(ne) = cellfun(@(g) g.NumComponents,obj.gmm(ne));   % [nT x nC]
    end
    
    function nComp = K(obj)
      nComp = obj.nComp; % keep this for now for forward compatibility, to be removed eventually
    end

    function out = merge(obj,groups,varargin)
      % MERGE Merge the components of each fit according to a partition.
      %
      %   gd2 = gd.merge(P[,'bic',tf])
      %   gd2 = gd.merge(partition)
      %   gd2 = gd.merge('nGroups',M[,'metric',m,...])
      %
      %   P is a cell {nT x nC} like gd.gmm, for example the P from
      %   bestPartition. P{i} is a partition of the components 1:K of the fit
      %   gd.gmm{i}, a cell of groups such as {[1 2],3}. Each group is
      %   replaced by one Gaussian with the group's total weight, mean and
      %   covariance (law of total covariance, see totalCovariance), in the
      %   order of the groups. Where P{i} is [] (or there is no fit) the entry
      %   of gd2 is empty.
      %
      %   A single partition (a cell of numeric groups, e.g. {[1 3],[2 4]}) is
      %   applied to all fits with that number of components K, and the rest
      %   are left empty.
      %
      %   The result has the same shape as gd.gmm, and the number of
      %   components may differ between entries (see gd2.nComp). Time, mass,
      %   data and options are kept. NumIterations etc. are lost.
      %   BIC: with companion data it is recomputed from the particles, which
      %   can be slow for many particles; 'bic',false skips that (NaN).
      %
      %   'nGroups',M uses the best partition into exactly M groups for every
      %   fit (see bestPartition), instead of P. The other options
      %   ('metric', 'normalized', 'nSamples', 'seed', 'K', 'maxK') go to
      %   bestPartition. Fits with fewer than M components are left empty.
      if ischar(groups) || isstring(groups)
        varargin = [{groups} varargin];
        groups = [];
      end
      p = inputParser;
      p.KeepUnmatched = true;
      addParameter(p,'bic',true);
      addParameter(p,'nGroups',[]);
      addParameter(p,'threshold',[]);
      parse(p,varargin{:});
      if ~isempty(p.Results.nGroups)
        rest = [fieldnames(p.Unmatched), struct2cell(p.Unmatched)]';
        [~,groups] = obj.bestPartition([],'nGroups',p.Results.nGroups,rest{:});
      elseif ~isempty(fieldnames(p.Unmatched))
        fn = fieldnames(p.Unmatched);
        error('GMDist:merge','Unknown option ''%s''.',fn{1})
      elseif isempty(groups)
        error('GMDist:merge','Give partitions P, a single partition, or ''nGroups''.')
      end

      % A single partition: use it for all fits with that K
      if iscell(groups) && ~isempty(groups) && all(cellfun(@(x) isnumeric(x) && ~isempty(x),groups(:)))
        K = numel(cell2mat(cellfun(@(x) x(:).',groups(:).','UniformOutput',false)));
        single = groups;
        groups = cell(size(obj.gmm));
        groups(obj.nComp == K) = {single};
      end
      if ~iscell(groups) || ~isequal(size(groups),size(obj.gmm))
        error('GMDist:merge','Partitions must be a cell of the same size as gmm ([%s]), or a single partition.', ...
          num2str(size(obj.gmm)))
      end

      nComp = obj.nComp;
      merged = cell(size(obj.gmm));
      for igmm = 1:numel(obj.gmm)
        g = obj.gmm{igmm};
        Pi = groups{igmm};
        if isempty(g) || isempty(Pi), continue, end
        K = nComp(igmm);
        if ~iscell(Pi), error('GMDist:merge','Entry %d: the partition must be a cell, e.g. {[1 2],3}.',igmm), end
        allc = cell2mat(cellfun(@(x) x(:).',Pi(:).','UniformOutput',false));
        if ~isequal(sort(allc),1:K)
          error('GMDist:merge','Entry %d: groups must be a partition of 1:%d (each component once).',igmm,K)
        end

        w = g.ComponentProportion;
        mu = g.mu;
        S = GMDist.fullSigma_(g);
        nG = numel(Pi);
        wM = zeros(1,nG); muM = zeros(nG,3); SM = zeros(3,3,nG);
        for ig = 1:nG
          [wM(ig),muM(ig,:),SM(:,:,ig)] = GMDist.totalCovariance_(w,mu,S,Pi{ig});
        end
        merged{igmm} = gmdistribution(muM,SM,wM);
      end

      args = {'time',obj.time,'mass',obj.mass_,'data',obj.data,'frac',obj.frac,'options',obj.options};
      if isempty(obj.data) || ~p.Results.bic
        args = [args {'bic',nan(size(merged))}];
      end
      out = GMDist(merged,args{:});
      out.misc.threshold = p.Results.threshold;
      out.misc.nCompOrig = obj.nCompOrig_();     % number of components before the merge
    end

    function [M,P,err] = bestPartition(obj,thr,varargin)
      % BESTPARTITION Fewest groups, per fit, whose best partition keeps the merge error below thr.
      %
      %   [M,P,err] = gd.bestPartition(thr[,option,value,...])
      %
      %   For every entry of gd.gmm with K components, M is the smallest number
      %   of groups for which the best partition (see mergeErrBest) has a
      %   distance of at most thr.
      %     M    [nT x nC]  number of groups (NaN if there is none, or no fit)
      %     P    {nT x nC}  that partition, a cell of groups, to use with merge
      %     err  [nT x nC]  its distance
      %   Options:
      %     'minGroups'  smallest M to consider (default 1)
      %     'maxGroups'  largest M to consider (default K, no merging)
      %     'nGroups'    exactly this many groups (same as minGroups = maxGroups);
      %                  thr may then be [] (no threshold). Fits with fewer
      %                  components than this get no partition.
      %   The other options ('metric', 'normalized', 'nSamples', 'seed', 'K',
      %   'maxK') go to mergeErrBest. For 'l1' thr is the fraction of the
      %   distribution that may be misplaced, for 'kl' nats per particle.
      p = inputParser;
      p.KeepUnmatched = true;
      addParameter(p,'minGroups',1);
      addParameter(p,'maxGroups',Inf);
      addParameter(p,'nGroups',[]);
      parse(p,varargin{:});
      mMin = p.Results.minGroups; mMax = p.Results.maxGroups;
      if ~isempty(p.Results.nGroups)
        mMin = p.Results.nGroups; mMax = mMin;
        if isempty(thr), thr = Inf; end
      end
      if ~isscalar(thr) || ~isnumeric(thr)
        error('GMDist:bestPartition','thr must be a number.')
      end
      rest = [fieldnames(p.Unmatched), struct2cell(p.Unmatched)]';
      rest = rest(:)';

      [bestErr,bestP] = obj.mergeErrBest(rest{:});
      nComp = obj.nComp;
      M = nan(size(obj.gmm));
      err = nan(size(obj.gmm));
      P = cell(size(obj.gmm));
      for igmm = 1:numel(obj.gmm)
        if isempty(bestErr{igmm}), continue, end
        K = nComp(igmm);
        for m = mMin:min(mMax,K)
          if bestErr{igmm}(m) <= thr
            M(igmm) = m;
            err(igmm) = bestErr{igmm}(m);
            P{igmm} = bestP{igmm}{m};
            break
          end
        end
      end
    end

    function kBest = kneeK(obj,varargin)
      % KNEEK Number of components at the knee of BIC vs K, per time.
      %
      %   kBest = gd.kneeK([,'method',m])
      %     'chord' (default)  the K where BIC lies farthest below the
      %                        straight line from the first to the last K
      %     'min'              the K with minimum BIC
      p = inputParser;
      addParameter(p,'method','chord');
      parse(p,varargin{:});
      method = validatestring(p.Results.method,{'chord','min'});

      [B,Ks] = obj.bicByK_();
      nT = size(B,1);
      kBest = nan(nT,1);
      for it = 1:nT
        ok = ~isnan(B(it,:));
        if ~any(ok), continue, end
        k = Ks(ok); b = B(it,ok);
        if strcmp(method,'min') || numel(k) < 3
          [~,i] = min(b);
        else
          x = (k-k(1))/(k(end)-k(1));
          y = (b-min(b))/max(max(b)-min(b),eps);
          d = (y(1) + (y(end)-y(1))*x) - y;
          [~,i] = max(d);
        end
        kBest(it) = k(i);
      end
    end

    function pop = populations(obj,varargin)
      % POPULATIONS Per-component properties of the fits with K components.
      %
      %   pop = gd.populations([,'n',nTot])
      %   Without 'K' the first non-empty fit at each time is used,
      %                                 whatever its number of components
      %
      %   Components are in the stored order (see sortBy). With K = [] the
      %   arrays are padded with NaN up to the largest number of components
      %   (pop.K). Fields:
      %     prop  [nT x K]         proportion
      %     n     [nT x K]         density [cm^-3] (NaN without total density)
      %     V     [nT x K x 3]     mean velocity [km/s]
      %     T     [nT x K x 3 x 3] temperature tensor [eV]
      %     Tiso  [nT x K]         trace(T)/3 [eV]
      %   'n': total density [cm^-3], [nT x 1]; default from the n method of
      %   the companion data, if it has one that works (e.g. MParts with weights).
      if size(obj.gmm,2) > 1               % one struct per column of gmm
        for ic = 1:size(obj.gmm,2)
          pop(ic) = obj.slice(':',ic).populations(varargin{:});
        end
        return
      end
      K = [];                              % the entry of the (single) column at each time
      p = inputParser;
      addParameter(p,'n',[]);
      parse(p,varargin{:});

      nC = obj.nComp;
      idx = obj.entryIndex_(K);
      if all(isnan(idx)) && ~isempty(K)
        error('GMDist:K','No fits with K = %s. Available: %s.',mat2str(K),mat2str(unique(nC(~isnan(nC))).'))
      end
      if all(isnan(idx)), Kmax = 1; else, Kmax = max(nC(idx(~isnan(idx)))); end   % K = [] and no fit: NaN output
      fac = obj.massFactor_();
      nT = size(obj.gmm,1);
      nTot = obj.totalDensity_(p.Results.n);

      prop = nan(nT,Kmax); n = nan(nT,Kmax); Tiso = nan(nT,Kmax);
      V = nan(nT,Kmax,3); T = nan(nT,Kmax,3,3);
      for it = 1:nT
        if isnan(idx(it)), continue, end
        g = obj.gmm{idx(it)};
        Kg = g.NumComponents;
        S = GMDist.fullSigma_(g);
        pr = g.ComponentProportion(:);
        Tc = fac*S;                                    % 3 x 3 x Kg
        prop(it,1:Kg) = pr.';
        Tiso(it,1:Kg) = reshape(Tc(1,1,:)+Tc(2,2,:)+Tc(3,3,:),[1,Kg])/3;
        n(it,1:Kg) = nTot(it)*obj.frac(idx(it))*pr.';
        V(it,1:Kg,:) = reshape(g.mu,[1 Kg 3]);
        for k = 1:Kg
          T(it,k,:,:) = reshape(Tc(:,:,k),[1 1 3 3]);
        end
      end
      pop = struct('K',Kmax,'prop',prop,'n',n,'V',V,'T',T,'Tiso',Tiso);
    end

    function [isCold,info] = cold(obj,varargin)
      % COLD Flag the cold components of every fit.
      %
      %   [isCold,info] = gd.cold([option,value,...])
      %
      %   isCold is a cell {nT x nC} like gd.gmm; isCold{i} is a logical
      %   [1 x K] saying which of the K components of the fit gd.gmm{i} are
      %   cold, in the stored component order (so call it before or after
      %   sortBy as needed). [] where there is no fit.
      %
      %   The components that carry weight are ranked by temperature, T =
      %   trace(T)/3 [eV] as in populations (components with weight 0, or
      %   below 'minWeight', never count as cold and are left out of the
      %   ranking, so that a collapsed component does not become the coldest).
      %   Methods ('method'):
      %     'knee' (default)  cold = the components below a gap in log10(T)
      %                       of at least 'minGapLog10' between neighbours in
      %                       the ranking. If there are several such gaps,
      %                       'gapPick' chooses 'first', 'last' (default) or
      %                       'largest'. With no such gap, the 'minColdK'
      %                       coldest components are cold.
      %     'threshold'       cold = components with T <= 'maxColdEV'
      %   Options:
      %     'minGapLog10'  0.35   gap in log10(T) for the knee (factor 2.2)
      %     'gapPick'      'last'
      %     'minWeight'    0      components lighter than this are never cold
      %     'minVabs'      0      post-filter: |mean velocity| [km/s] at least this
      %     'maxColdEV'    []     post-filter ('knee') or the criterion ('threshold') [eV]
      %     'minColdK'     1      number of cold components if there is no gap
      %     'maxColdK'     []     at most this many cold components (the coldest)
      %   The post-filters discard components from the selected set without
      %   promoting others to replace them.
      %
      %   info (cells {nT x nC}, like gd.gmm, plus method):
      %     info.T_eV        [1 x K]  temperature of each component, stored order
      %     info.vabs_kms    [1 x K]  |mean velocity|, stored order
      %     info.isort       indices of the components with weight, coldest first
      %     info.gaps_log10  gaps in log10(T) between neighbours of the ranking
      %     info.cold        indices of the cold components, stored order
      p = inputParser;
      p.FunctionName = 'GMDist.cold';
      isTextScalar = @(x) ischar(x) || (isstring(x) && isscalar(x));
      isNonnegativeScalar = @(x) isnumeric(x) && isscalar(x) && ...
        isreal(x) && isfinite(x) && x >= 0;
      isPositiveInteger = @(x) isnumeric(x) && isscalar(x) && ...
        isreal(x) && isfinite(x) && x >= 1 && fix(x) == x;
      isEmptyOrPositiveInteger = @(x) isempty(x) || isPositiveInteger(x);
      isEmptyOrNonnegativeScalar = @(x) isempty(x) || isNonnegativeScalar(x);
      addParameter(p,'method',      'knee', isTextScalar);
      addParameter(p,'minGapLog10', 0.35,   isNonnegativeScalar);
      addParameter(p,'gapPick',     'last', isTextScalar);
      addParameter(p,'minWeight',   0,      isNonnegativeScalar);
      addParameter(p,'minVabs',     0,      isNonnegativeScalar);
      addParameter(p,'maxColdEV',   [],     isEmptyOrNonnegativeScalar);
      addParameter(p,'minColdK',    1,      isPositiveInteger);
      addParameter(p,'maxColdK',    [],     isEmptyOrPositiveInteger);
      parse(p,varargin{:});
      method = validatestring(char(p.Results.method),{'knee','threshold'});
      gapPick = validatestring(char(p.Results.gapPick),{'first','last','largest'});
      minGapLog10 = p.Results.minGapLog10;
      minWeight = p.Results.minWeight;
      minVabs = p.Results.minVabs;
      maxColdEV = p.Results.maxColdEV;
      minColdK = p.Results.minColdK;
      maxColdK = p.Results.maxColdK;
      if strcmp(method,'threshold') && isempty(maxColdEV)
        error('GMDist:cold','Method ''threshold'' requires ''maxColdEV''.')
      end

      fac = obj.massFactor_();               % (km/s)^2 -> eV, as in populations
      isCold = cell(size(obj.gmm));
      info.method = method;
      info.T_eV = cell(size(obj.gmm));
      info.vabs_kms = cell(size(obj.gmm));
      info.isort = cell(size(obj.gmm));
      info.gaps_log10 = cell(size(obj.gmm));
      info.cold = cell(size(obj.gmm));

      for igmm = 1:numel(obj.gmm)
        g = obj.gmm{igmm};
        if isempty(g), continue, end
        K = g.NumComponents;
        S = GMDist.fullSigma_(g);
        w = g.ComponentProportion(:).';
        T = zeros(1,K);
        for k = 1:K, T(k) = fac*trace(S(:,:,k))/3; end
        vabs = sqrt(sum(g.mu.^2,2)).';
        info.T_eV{igmm} = T;
        info.vabs_kms{igmm} = vabs;

        % Rank the components that carry weight by temperature, coldest first
        active = find(w > 0 & w >= minWeight);
        [~,o] = sort(T(active),'ascend');
        iord = active(o);
        info.isort{igmm} = iord;
        nA = numel(iord);

        flag = false(1,K);
        if nA > 0
          eligible = vabs(iord) >= minVabs;
          if ~isempty(maxColdEV), eligible = eligible & T(iord) <= maxColdEV; end
          switch method
            case 'knee'
              gaps = diff(log10(max(T(iord),realmin)));
              info.gaps_log10{igmm} = gaps;
              iGaps = find(gaps >= minGapLog10);
              if nA == 1
                cs = 1;
              elseif ~isempty(iGaps)
                switch gapPick
                  case 'first',   iGap = iGaps(1);
                  case 'last',    iGap = iGaps(end);
                  case 'largest', [~,iRel] = max(gaps(iGaps)); iGap = iGaps(iRel);
                end
                cs = 1:iGap;
              else
                cs = 1:min(minColdK,nA);
              end
              if ~isempty(maxColdK) && numel(cs) > maxColdK, cs = cs(1:maxColdK); end
              cs = cs(eligible(cs));
            case 'threshold'
              cs = find(eligible);
              if ~isempty(maxColdK) && numel(cs) > maxColdK, cs = cs(1:maxColdK); end
          end
          flag(iord(cs)) = true;
        end
        isCold{igmm} = flag;
        info.cold{igmm} = find(flag);
      end
    end

    function [out,frac] = subMixture(obj,sel,varargin)
      % SUBMIXTURE The selected components of every fit, as a GMDist.
      %
      %   [sub,frac] = gd.subMixture(sel[,'complement',tf])
      %
      %   sel: a cell {nT x nC} like gd.gmm, each element a logical [1 x K] or
      %   a vector of component indices in the stored order (for example
      %   isCold from cold); or one logical/index vector used for all fits
      %   (indices above K are ignored). 'complement',true keeps the other
      %   components instead (e.g. the hot part: gd.subMixture(isCold,'complement',true)).
      %
      %   Each fit keeps its selected components, renormalized to sum to 1, so
      %   sub is a proper mixture and all methods work on it. frac [nT x nC] is
      %   the share of the original weight that the selection carried, to
      %   recover densities: the density of the part is n_total.*frac. Entries
      %   with no selected weight are empty (frac NaN).
      %
      %   The share is also stored in sub.frac (multiplied with any earlier
      %   frac), and the density methods (populations, tsN, tsReduced,
      %   tsSkymap, ...) use it, so a sub-mixture has the density it carries:
      %   n_total(t) * frac * proportion. Without a total density the reduced
      %   pdfs are normalized to 1 times frac. The companion data is kept (for
      %   the total density); the BIC is NaN, since a sub-mixture is not a fit.
      p = inputParser;
      addParameter(p,'complement',false);
      parse(p,varargin{:});

      if ~iscell(sel), sel = repmat({sel},size(obj.gmm)); end
      if ~isequal(size(sel),size(obj.gmm))
        error('GMDist:subMixture','sel must be a cell of the same size as gmm ([%s]), or one vector.',num2str(size(obj.gmm)))
      end
      sub = cell(size(obj.gmm));
      frac = nan(size(obj.gmm));
      for i = 1:numel(obj.gmm)
        g = obj.gmm{i};
        if isempty(g), continue, end
        K = g.NumComponents;
        si = sel{i};
        if islogical(si), si = find(si); end
        si = unique(si(si >= 1 & si <= K));
        if p.Results.complement, si = setdiff(1:K,si); end
        if isempty(si), continue, end
        w = g.ComponentProportion(si);
        ws = sum(w);
        if ~(ws > 0), continue, end          % nothing with weight is selected
        S = GMDist.fullSigma_(g);
        sub{i} = gmdistribution(g.mu(si,:),S(:,:,si),w/ws);   % gmdistribution normalizes to 1
        frac(i) = ws;
      end
      out = GMDist(sub,'time',obj.time,'mass',obj.mass_,'data',obj.data, ...
        'bic',nan(size(sub)),'frac',obj.frac.*frac,'options',obj.options);
      if isfield(obj.misc,'nCompOrig'), out.misc.nCompOrig = obj.misc.nCompOrig; end
    end

    function s = byNComp(obj,varargin)
      % BYNCOMP Temperatures of the fits and their neighbour differences, grouped by M = nComp.
      %
      %   s = gd.byNComp([option,value,...])
      %
      %   One result per column of gd.gmm: a struct array for one column, a cell
      %   {1 x nC} of struct arrays for several. A struct array has one element
      %   for each number of components M that occurs in that column
      %   (ascending), collecting the fits with that M, with the components of
      %   each fit sorted by temperature, coldest first. Fields:
      %     M       number of components
      %     entry   linear indices into gd.gmm of these fits [n x 1]
      %     it, ic  their row (time index) and column in gd.gmm [n x 1]
      %     Korig   number of components of these fits before merge [n x 1]
      %             (from gd.misc.nCompOrig; equal to M if the object was not merged)
      %     time    their times (like gd.time(it)), [] if gd has no time
      %     T       [n x M]      temperature trace(T)/3 [eV], sorted ascending
      %     dT      [n x (M-1)]  T(:,2:end) - T(:,1:end-1)
      %     dlogT   [n x (M-1)]  the same in log10(T)
      %     w       [n x M]      proportions, in the same order as T
      %     V       [n x M x 3]  mean velocity [km/s], same order
      %     vabs    [n x M]      |V| [km/s]
      %     n       [n x M]      density [cm^-3] = total density * frac * proportion
      %                          (NaN without a total density)
      %   Options:
      %     'col'        only these columns of gmm (default all). One column: a
      %                  struct array; several: a cell, one struct array each
      %     'pool'       true: put the fits of all the columns in 'col' into one
      %                  struct array. This mixes fits from different columns
      %                  (and original K), and the same time can occur once per
      %                  column: use ic and Korig to separate them (default false)
      %     'minWeight'  components lighter than this get T = NaN (sorted last;
      %                  default 0: only a NaN-free ranking)
      %     'n'          total density [cm^-3], [nT x 1]; default from the
      %                  companion data, as in populations
      p = inputParser;
      addParameter(p,'col',[]);
      addParameter(p,'pool',false);
      addParameter(p,'minWeight',0);
      addParameter(p,'n',[]);
      parse(p,varargin{:});
      col = p.Results.col;
      if isempty(col), col = 1:size(obj.gmm,2); end

      if numel(col) > 1 && ~p.Results.pool
        s = cell(1,numel(col));
        for j = 1:numel(col)
          s{j} = obj.byNComp('col',col(j),'minWeight',p.Results.minWeight,'n',p.Results.n);
        end
        return
      end

      nC = obj.nComp;
      KO = obj.nCompOrig_();
      fac = obj.massFactor_();
      nTot = obj.totalDensity_(p.Results.n);
      t = obj.time;

      Ms = unique(nC(:,col));
      Ms = Ms(~isnan(Ms)).';
      s = struct('M',{},'entry',{},'it',{},'ic',{},'Korig',{},'time',{},'T',{},'dT',{},'dlogT',{},'w',{},'V',{},'vabs',{},'n',{});
      for m = Ms
        [it,jc] = find(nC(:,col) == m);
        [it,o] = sort(it);                    % by time
        ic = col(jc(o)); ic = ic(:);
        n = numel(it);
        T = nan(n,m); W = nan(n,m); V = nan(n,m,3); N = nan(n,m);
        for i = 1:n
          g = obj.gmm{it(i),ic(i)};
          S = GMDist.fullSigma_(g);
          w = g.ComponentProportion(:).';
          Ti = zeros(1,m);
          for k = 1:m, Ti(k) = fac*trace(S(:,:,k))/3; end
          Ti(w < p.Results.minWeight) = NaN;
          [Ti,oo] = sort(Ti,'ascend');        % NaN last
          T(i,:) = Ti;
          W(i,:) = w(oo);
          V(i,:,:) = reshape(g.mu(oo,:),[1 m 3]);
          N(i,:) = nTot(it(i))*obj.frac(it(i),ic(i))*w(oo);
        end
        e.M = m;
        e.entry = sub2ind(size(obj.gmm),it,ic);
        e.it = it; e.ic = ic;
        e.Korig = KO(e.entry);
        if isempty(t), e.time = []; else, e.time = t(it); end
        e.T = T;
        e.dT = diff(T,1,2);
        e.dlogT = diff(log10(T),1,2);
        e.w = W;
        e.V = V;
        e.vabs = sqrt(sum(V.^2,3));
        e.n = N;
        s(end+1) = e; %#ok<AGROW>
      end
    end

    function gm = marginal(obj,it,dims,varargin)
      % MARGINAL Marginal mixture over velocity dimensions dims (subset of 1:3),
      % for the fit at time index it in column 'col' (default: the first non-empty fit).
      p = inputParser;
      addParameter(p,'col',[]);
      parse(p,varargin{:});
      if isempty(p.Results.col)
        ie = obj.entryAt_(it,[]);
      else
        ie = sub2ind(size(obj.gmm),it,p.Results.col);
      end
      if isnan(ie) || isempty(obj.gmm{ie}), error('GMDist:fit','No fit at time index %d.',it), end
      g = obj.gmm{ie};
      S = GMDist.fullSigma_(g);
      gm = gmdistribution(g.mu(:,dims),S(dims,dims,:),g.ComponentProportion);
    end

    function out = slice(obj,it,ic)
      % SLICE A GMDist restricted to some rows (times) and columns of gmm.
      %
      %   gd1 = gd.slice(it,ic)    like A(it,ic)
      %   gd1 = gd.slice(it)       all columns
      %   gd1 = gd.slice([],ic)    all times
      %
      %   it, ic: indices, logical masks, [] or ':' (all). The result is a
      %   GMDist, so all methods work on it. Time, BIC and the companion data
      %   are sliced too (the data is dropped with a warning if it cannot be
      %   indexed in time). To select by number of components, see keepNComp.
      nT = size(obj.gmm,1); nC = size(obj.gmm,2);
      if nargin < 2 || isempty(it) || (ischar(it) && strcmp(it,':')), it = 1:nT; end
      if nargin < 3 || isempty(ic) || (ischar(ic) && strcmp(ic,':')), ic = 1:nC; end
      if islogical(it), it = find(it); end
      if islogical(ic), ic = find(ic); end
      if any(it < 1) || any(it > nT) || any(it ~= round(it))
        error('GMDist:slice','Time indices must be integers in 1:%d.',nT)
      end
      if any(ic < 1) || any(ic > nC) || any(ic ~= round(ic))
        error('GMDist:slice','Column indices must be integers in 1:%d.',nC)
      end

      t = obj.time;
      if ~isempty(t), t = t(it); end
      d = obj.data;
      if ~isempty(d)
        try
          d = d(it);
        catch
          warning('GMDist:slice','Could not slice the companion data in time; dropping it.')
          d = [];
        end
      end
      out = GMDist(obj.gmm(it,ic),'time',t,'mass',obj.mass_,'data',d, ...
        'bic',obj.bic(it,ic),'frac',obj.frac(it,ic),'options',obj.options);
      if isfield(obj.misc,'nCompOrig') && isequal(size(obj.misc.nCompOrig),size(obj.gmm))
        out.misc.nCompOrig = obj.misc.nCompOrig(it,ic);
      end
    end

    function out = sliceTime(obj,it)
      % SLICETIME Same as slice(it): all columns, selected times.
      out = obj.slice(it,[]);
    end

    function out = keepNComp(obj,M,varargin)
      % KEEPNCOMP Keep only the fits with M components; the others become empty.
      %
      %   gd1 = gd.keepNComp(M[,'invert',tf])
      %
      %   M: one or more numbers of components. The layout (times and columns)
      %   is unchanged, so rows and columns still mean what they did; masked
      %   entries are [] like a missing fit, with BIC and frac NaN, and the
      %   methods that work per column then give NaN there. 'invert',true
      %   masks the fits with M components instead and keeps the rest.
      %   For example, all the data with three components: gd.keepNComp(3).
      p = inputParser;
      addParameter(p,'invert',false);
      parse(p,varargin{:});
      nC = obj.nComp;
      keep = ismember(nC,M);
      if p.Results.invert, keep = ~keep & ~isnan(nC); end
      g = obj.gmm; g(~keep) = {[]};
      B = obj.bic; B(~keep) = NaN;
      F = obj.frac; F(~keep) = NaN;
      out = GMDist(g,'time',obj.time,'mass',obj.mass_,'data',obj.data, ...
        'bic',B,'frac',F,'options',obj.options);
      out.misc = obj.misc;
    end

    function r = reducedVDFs(obj,it,dim,varargin)
      % REDUCEDVDFS Reduced VDFs at one time: total, each component and a merged mixture.
      %
      %   r = gd.reducedVDFs(it,dim[,'col',ic][,'groups',partition][,option,value,...])
      %
      %   it: one time index. K: the number of components of the fit to use,
      %   or [] for the first non-empty fit at that time (e.g. after merge).
      %   dim: 1, 2 or 3. partition: a partition of 1:K as in merge, e.g.
      %   {[1 3],[2 4]}. Options 'vg', 'nv' and 'n' are those of tsReduced; one
      %   velocity grid is used for everything, so the curves share an axis.
      %   Output fields:
      %     r.it, r.K, r.dim, r.vg
      %     r.all      PDist, the whole mixture
      %     r.comp     {1 x K} PDist, one per component (not renormalized, they
      %                add up to r.all)
      %     r.groups   the partition given (only with 'groups')
      %     r.merged   PDist, the merged mixture (only with 'groups')
      %     r.merged_comp  {1 x numel(groups)} PDist, one per merged component
      %                (the single Gaussian of each group; only with 'groups')
      %   Each PDist has one time; use .depend{1} and .data.
      p = inputParser;
      addParameter(p,'groups',[]);
      addParameter(p,'vg',[]);
      addParameter(p,'nv',200);
      addParameter(p,'n',[]);
      addParameter(p,'col',[]);
      parse(p,varargin{:});
      if ~isscalar(it)
        error('GMDist:reducedVDFs','it must be a scalar time index; use slice for several.')
      end
      col = p.Results.col;
      if isempty(col)                                    % first non-empty fit at that time
        ie = obj.entryAt_(it,[]);
        if isnan(ie), error('GMDist:fit','No fit at time index %d.',it), end
        [~,col] = ind2sub(size(obj.gmm),ie);
      end
      one = obj.slice(it,col);
      if isnan(one.nComp), error('GMDist:fit','No fit at time index %d in column %d.',it,col), end
      K = one.nComp;

      vg = p.Results.vg;
      if isempty(vg), vg = one.defaultGrid_(one.entryIndex_([]),dim,p.Results.nv); end
      args = {'vg',vg,'n',p.Results.n};

      r.it = it; r.K = K; r.dim = dim; r.vg = vg(:).';
      r.all = one.tsReduced(dim,args{:});
      r.comp = one.tsReduced(dim,args{:},'component',num2cell(1:K));
      if ~isempty(p.Results.groups)
        groups = p.Results.groups;
        merged = one.merge(groups);
        r.groups = groups;
        r.merged = merged.tsReduced(dim,args{:});
        r.merged_comp = merged.tsReduced(dim,args{:},'component',num2cell(1:numel(groups)));
      end
    end

    function obj = sortBy(obj,quantity,varargin)
      % SORTBY Reorder the components of every fit.
      %
      %   gd = gd.sortBy(q[,'direction',d])
      %     q: 'T'     trace of the covariance (temperature)
      %        'n'     component proportion (density)
      %        'vabs'  length of the mean velocity
      %     d: 'ascend' (default: coldest / lowest density / slowest first)
      %        or 'descend'.
      %   BIC is kept. Other fitgmdist metadata (NumIterations, ...) is lost,
      %   since the mixtures are rebuilt with the new order.
      p = inputParser;
      addParameter(p,'direction','ascend');
      parse(p,varargin{:});
      quantity = validatestring(quantity,{'T','n','vabs'});
      dirn = validatestring(p.Results.direction,{'ascend','descend'});

      out = obj.gmm;
      order = cell(size(obj.gmm));
      for i = 1:numel(out)
        g = out{i};
        if isempty(g), continue, end
        S = GMDist.fullSigma_(g);
        switch quantity
          case 'T'
            key = arrayfun(@(k) trace(S(:,:,k)),(1:g.NumComponents).');
          case 'n'
            key = g.ComponentProportion(:);
          case 'vabs'
            key = sqrt(sum(g.mu.^2,2));
        end
        [~,o] = sort(key,dirn);
        order{i} = o(:)';        
        w = max(g.ComponentProportion(o),eps);
        out{i} = gmdistribution(g.mu(o,:),S(:,:,o),w);
      end
      m0 = obj.misc;
      obj = GMDist(out,'time',obj.time,'mass',obj.mass_,'data',obj.data, ...
        'bic',obj.bic,'frac',obj.frac,'options',obj.options);
      obj.misc = m0;
      obj.misc.sort = order;
    end

    function ts = tsProp(obj,varargin)
      % TSPROP Proportion of each component: cell {1 x K} of scalar TSeries.
      if size(obj.gmm,2) > 1, ts = obj.perColumn_(@(g) g.tsProp(varargin{:})); return, end
      pop = obj.populations(varargin{:});
      K = pop.K;
      t = obj.tsTime_();
      nT = size(pop.prop,1);
      ts = cell(1,K);
      for k = 1:K
        ts{k} = irf.ts_scalar(t,reshape(pop.prop(:,k),[nT 1]));
      end
    end

    function ts = tsN(obj,varargin)
      % TSN Density [cm^-3] of each component: cell {1 x K} of scalar TSeries.
      %   Needs a total density: companion data with an n method, or 'n'.
      if size(obj.gmm,2) > 1, ts = obj.perColumn_(@(g) g.tsN(varargin{:})); return, end
      pop = obj.populations(varargin{:});
      K = pop.K;
      if all(isnan(pop.n(:))) && ~all(isnan(pop.prop(:)))
        error('GMDist:n','No total density available; give ''n'' or use tsProp.')
      end
      t = obj.tsTime_();
      nT = size(pop.n,1);
      ts = cell(1,K);
      for k = 1:K
        ts{k} = irf.ts_scalar(t,reshape(pop.n(:,k),[nT 1]));        
      end      
    end

    function ts = tsV(obj,varargin)
      % TSV Mean velocity [km/s] of each component: cell {1 x K} of vector TSeries.
      if size(obj.gmm,2) > 1, ts = obj.perColumn_(@(g) g.tsV(varargin{:})); return, end
      pop = obj.populations(varargin{:});
      K = pop.K;
      t = obj.tsTime_();
      nT = size(pop.V,1);
      ts = cell(1,K);
      for k = 1:K
        ts{k} = irf.ts_vec_xyz(t,reshape(pop.V(:,k,:),[nT 3]));
      end
      %varargout = {ts
    end

    function ts = tsT(obj,varargin)
      % TST Temperature [eV] of each component: cell {1 x K} of TSeries.
      %   ts = gd.tsT()                  tensor TSeries (default)
      %   ts = gd.tsT('type','diag')    TSeries [nT x 3] of the diagonal
      %   ts = gd.tsT('type','iso')     scalar TSeries of trace(T)/3
      if size(obj.gmm,2) > 1, ts = obj.perColumn_(@(g) g.tsT(varargin{:})); return, end
      p = inputParser;
      addParameter(p,'type','tensor');
      parse(p,varargin{:});
      type = validatestring(p.Results.type,{'iso','diag','tensor'});
      pop = obj.populations();
      K = pop.K;
      t = obj.tsTime_();
      nT = size(pop.T,1);
      ts = cell(1,K);
      switch type
        case 'iso'
          for k = 1:K
            ts{k} = irf.ts_scalar(t,reshape(pop.Tiso(:,k),[nT 1]));
          end
        case 'diag'
          for k = 1:K
            ts{k} = irf.ts_scalar(t,reshape(pop.T(:,k,[1 5 9]),[nT 3 1]));
          end
        case 'tensor'
          for k = 1:K
            ts{k} = irf.ts_tensor_xyz(t,reshape(pop.T(:,k,:,:),[nT 3 3]));
          end
      end
    end

    function [ts,Ks] = tsBIC(obj,varargin)
      % TSBIC BIC as a TSeries [nT x nK]; Ks are the K of the columns (ascending).
      %
      %   [ts,Ks] = gd.tsBIC('normalization',n)
      %     'none'   (default) raw BIC
      %     'min'    BIC - min over K, per time
      %     'max'    BIC / max over K, per time (sensible for positive BIC)
      %     'range'  (BIC - min)/(max - min) over K, per time
      p = inputParser;
      addParameter(p,'normalization','none');
      parse(p,varargin{:});
      nrm = validatestring(p.Results.normalization,{'none','min','max','range'});
      [B,Ks] = obj.bicByK_();
      switch nrm
        case 'min'
          B = B - min(B,[],2,'omitnan');
        case 'max'
          B = B./max(B,[],2,'omitnan');
        case 'range'
          lo = min(B,[],2,'omitnan');
          B = (B-lo)./max(max(B,[],2,'omitnan')-lo,eps);
      end
      ts = irf.ts_scalar(obj.tsTime_(),B);
      ts.name = 'BIC';
      ts.userData.specrec.f = Ks;
      ts.userData.specrec.f_label = 'K';
      ts.userData.specrec.p_label = 'BIC';
    end

    function [tsL2err, tsL2NGroups] = tsMergeErrPartitions(obj,varargin)
      % TSMERGEERRPARTITIONS TSeries of the merge distance for all partitions of each fit.
      %
      %   [tsErr, tsNGroups] = gd.tsMergeErrPartitions([option,value,...])
      %
      %   One result per column of gd.gmm: a TSeries for one column, a cell
      %   {1 x nC} for several (select columns with slice). For a column, the
      %   entry at each time is used:
      %     tsErr      [nT x nP]  distance of each partition of its components
      %     tsNGroups  [nT x nP]  number of groups in each partition
      %   If the number of components varies over time, nP is the largest and
      %   the rest is NaN. tsErr.userData.listPartitions{it,ip} is the partition.
      %   Options are those of mergeErrPartitions ('metric', 'normalized',
      %   'nSamples', 'seed', 'sort', 'maxK').
      if size(obj.gmm,2) > 1
        nC = size(obj.gmm,2);
        tsL2err = cell(1,nC); tsL2NGroups = cell(1,nC);
        for ic = 1:nC
          [tsL2err{ic},tsL2NGroups{ic}] = obj.slice(':',ic).tsMergeErrPartitions(varargin{:});
        end
        return
      end
      t = obj.tsTime_();
      nT = obj.nT;
      [err,P,nGroups] = obj.mergeErrPartitions(varargin{:});    % {nT x 1}
      nPartitions = max([0; cellfun(@numel,err(:))]);
      if nPartitions == 0, error('GMDist:fit','No fits.'), end
      E = nan(nT,nPartitions); N = nan(nT,nPartitions); PL = cell(nT,nPartitions);
      for it = 1:nT
        if isempty(err{it}), continue, end
        n = numel(err{it});
        E(it,1:n) = err{it};
        N(it,1:n) = nGroups{it};
        PL(it,1:n) = P{it};
      end

      label = GMDist.metricLabel_(GMDist.metricFromArgs_(varargin));
      tsL2err = irf.ts_scalar(t,E);
      tsL2err.name = label;
      tsL2err.userData.specrec.f = 1:nPartitions;
      tsL2err.userData.specrec.f_label = '1:N_P';
      tsL2err.userData.specrec.p_label = label;
      tsL2err.userData.listPartitions = PL;

      tsL2NGroups = irf.ts_scalar(t,N);
      tsL2NGroups.name = 'M = N_{inP}';
      tsL2NGroups.userData.specrec.f = 1:nPartitions;
      tsL2NGroups.userData.specrec.f_label = '1:N_P';
      tsL2NGroups.userData.specrec.p_label = 'M = N_{inP}';
      tsL2NGroups.userData.listPartitions = PL;
    end

    function TS = tsMergeErrBest(obj,varargin)
      % TSMERGEERRBEST TSeries of the best merge distance for each number of groups M.
      %
      %   TS = gd.tsMergeErrBest([option,value,...])
      %
      %   One result per column of gd.gmm: a TSeries for one column, a cell
      %   {1 x nC} for several (select columns with slice). For a column, the
      %   entry at each time is used. TS is [nT x Mmax], TS(it,M) the distance
      %   of the best partition into M groups (NaN-padded if the number of
      %   components varies over time). TS.userData.listPartitions{it,M} is that
      %   partition. Options are those of mergeErrPartitions.
      if size(obj.gmm,2) > 1
        TS = obj.perColumn_(@(g) g.tsMergeErrBest(varargin{:}));
        return
      end
      t = obj.tsTime_();
      nT = obj.nT;
      [bestErr,bestP] = obj.mergeErrBest(varargin{:});         % {nT x 1}
      Mmax = max([0; cellfun(@numel,bestErr(:))]);
      if Mmax == 0, error('GMDist:fit','No fits.'), end
      B = nan(nT,Mmax); PL = cell(nT,Mmax);
      for it = 1:nT
        if isempty(bestErr{it}), continue, end
        n = numel(bestErr{it});
        B(it,1:n) = bestErr{it};
        PL(it,1:n) = bestP{it};
      end

      label = GMDist.metricLabel_(GMDist.metricFromArgs_(varargin));
      TS = irf.ts_scalar(t,B);
      TS.name = label;
      TS.userData.specrec.f = 1:Mmax;
      TS.userData.specrec.f_label = 'M = N_{inP}';
      TS.userData.specrec.p_label = ['min(' label ')'];
      TS.userData.listPartitions = PL;
    end

    function PD = tsReduced(obj,dim,varargin)
      % TSREDUCED Reduced (1D marginal) distribution along vx, vy or vz as PDist.
      %
      %   PD = gd.tsReduced(dim[,option,value,...])
      %
      %   One PDist per column of gd.gmm: a PDist for one column, a cell {1 x nC}
      %   for several (select columns with slice). Within a column the
      %   entry at each time is used, whatever its number of components.
      %   dim: 1 (vx), 2 (vy) or 3 (vz). 2D reductions are not done yet.
      %   Options:
      %     'component'  0 (default): the total mixture.
      %                  A vector of component numbers, e.g. [1 2]: the sum
      %                  of those components (each weighted by its proportion),
      %                  as one PDist.
      %                  A cell, e.g. {[1 2],3}: a cell of the same shape with
      %                  one PDist per element ({PDist12,PDist3}).
      %     'vg'         velocity grid [km/s]; default spans the fitted means +- 4 sd
      %     'nv'         number of grid points of the default grid (200)
      %     'n'          total density [cm^-3], [nT x 1]; default from the
      %                  companion data. Without it the pdf is normalized to 1.
      %   Units: cm^-3 (km/s)^-1, or (km/s)^-1 if normalized.
      if size(obj.gmm,2) > 1               % one PDist per column of gmm
        PD = obj.perColumn_(@(g) g.tsReduced(dim,varargin{:}));
        return
      end
      o = obj.reducedOpts_(dim,varargin);
      t = obj.tsTime_();
      comp = o.component;
      if iscell(comp)
        PD = cell(size(comp));
        for i = 1:numel(comp)
          PD{i} = obj.reducedPD_(t,o,dim,comp{i});
        end
      else
        PD = obj.reducedPD_(t,o,dim,comp);
      end
    end

    function PD = tsSkymap(obj,varargin)
      % TSSKYMAP The mixture evaluated on a skymap grid, as PDist.
      %
      %   PD = gd.tsSkymap('template',pd[,option,value,...])
      %
      %   Uses pdist_generalized_maxwellian. 'template' is a PDist skymap with
      %   the same times as the fits; it provides the grid. The output is in
      %   the template's grid, units s^3/km^6 (as that function returns).
      %   Needs a total density (companion n method, or 'n').
      %   K = []: the first non-empty fit at each time, whatever its number of
      %   components. K vector: cell {1 x numel(K)}, one per K.
      %   Options:
      %     'template'   PDist providing the grid (required)
      %     'component'  as in tsReduced: 0 (default, whole mixture), a vector
      %                  of component numbers (their sum, one PDist), or a cell
      %                  such as {[1 2],3} (cell of PDist).
      %     'n'          total density [cm^-3], [nT x 1]
      %   Times where there is no fit contribute zero.
      if size(obj.gmm,2) > 1               % one PDist per column of gmm
        PD = obj.perColumn_(@(g) g.tsSkymap(varargin{:}));
        return
      end
      p = inputParser;
      addParameter(p,'template',[]);
      addParameter(p,'component',0);
      addParameter(p,'n',[]);
      parse(p,varargin{:});
      pd = p.Results.template;
      if isempty(pd)
        error('GMDist:template','tsSkymap needs ''template'', a PDist providing the grid.')
      end
      idx = obj.entryIndex_([]);
      if all(isnan(idx)), error('GMDist:fit','No fits.'), end
      nT = size(obj.gmm,1);
      if length(pd.time) ~= nT
        error('GMDist:template','The template has %d times but the fits have %d.',length(pd.time),nT)
      end

      pop = obj.populations('n',p.Results.n);
      Kmax = pop.K;
      if all(isnan(pop.n(:)))
        error('GMDist:n','No total density available; give ''n''.')
      end
      % Arrays in the gmdistribution layout used by pdist_generalized_maxwellian;
      % missing components and times get zero weight
      w = 1e-3*pop.n.';                 % [K,nT]; same cm^-3 scaling that the function applies to TSeries input
      w(isnan(w)) = 0;
      mu = permute(pop.V,[2 3 1]);      % [K,3,nT], km/s
      mu(isnan(mu)) = 0;
      sigma = repmat(eye(3),[1 1 Kmax nT]);   % [3,3,K,nT], (km/s)^2
      for it = 1:nT
        if isnan(idx(it)), continue, end
        g = obj.gmm{idx(it)};
        sigma(:,:,1:g.NumComponents,it) = GMDist.fullSigma_(g);
      end

      comp = p.Results.component;
      if iscell(comp)
        PD = cell(size(comp));
        for i = 1:numel(comp)
          PD{i} = GMDist.skymapPD_(pd,w,mu,sigma,comp{i},Kmax);
        end
      else
        PD = GMDist.skymapPD_(pd,w,mu,sigma,comp,Kmax);
      end
    end

    function PD = plotReduced(obj,dim,varargin)
      % PLOTREDUCED Plot reduced spectrograms of the fitted mixtures; returns the PDist.
      %
      %   PD = gd.plotReduced(dim[,option,value,...])
      %
      %   One spectrogram (irf_spectrogram) per column of gd.gmm, in a column of
      %   panels (select columns with slice). PD is a PDist for one column and
      %   a cell {1 x nC} otherwise. Options are those of tsReduced ('component'
      %   is ignored here).
      t = obj.tsTime_();
      nC = size(obj.gmm,2);
      PD = cell(1,nC);
      tiledlayout(nC,1);
      for ic = 1:nC
        one = obj.slice(':',ic);
        o = one.reducedOpts_(dim,varargin);
        D = one.reducedData_(o.idx,dim,o.vg,0,o.scale);
        ax = nexttile;
        if o.normalized, pl = 'pdf [(km/s)^{-1}]'; else, pl = 'cm^{-3} (km/s)^{-1}'; end
        axn = 'xyz';
        spec = struct('t',t.epochUnix,'f',o.vg,'p',{{D}}, ...
          'f_label',{{sprintf('v_%s [km/s]',axn(dim))}},'p_label',{{pl}});
        irf_spectrogram(ax,spec);
        title(ax,sprintf('column %d',ic));
        try
          PD{ic} = GMDist.makePDist_(t,D,o.vg);
        catch ME
          warning('GMDist:pdist','Could not build PDist: %s',ME.message)
        end
      end
      if nC == 1, PD = PD{1}; end
    end

    function h = plotBIC(obj,ax)
      % PLOTBIC BIC - min(BIC) over time and K, with the knee overlaid.
      if nargin < 2, ax = gca; end
      [B,Ks] = obj.bicByK_();
      B = B - min(B,[],2,'omitnan');
      [x,isDate] = obj.xTime_();
      h = imagesc(ax,x,Ks,B.');
      axis(ax,'xy'); ylabel(ax,'K'); title(ax,'BIC - min(BIC)'); colorbar(ax);
      hold(ax,'on'); plot(ax,x,obj.kneeK(),'w.'); hold(ax,'off')
      if isDate, datetick(ax,'x','keeplimits'); end
    end

    function ax = plotComponents(obj,varargin)
      % PLOTCOMPONENTS Proportion (or density), speed and temperature of
      % the components over time. Extra arguments go to populations.
      if size(obj.gmm,2) > 1
        error('GMDist:plotComponents','plotComponents works on one column; use slice('':'',col).')
      end
      pop = obj.populations(varargin{:});
      K = pop.K;
      [x,isDate] = obj.xTime_();
      tiledlayout(3,1);
      ax(1) = nexttile;
      if all(isnan(pop.n(:)))
        plot(x,pop.prop,'.-'); ylabel('proportion')
      else
        plot(x,pop.n,'.-'); ylabel('n [cm^{-3}]')
      end
      legend(arrayfun(@(k) sprintf('comp %d',k),1:K,'UniformOutput',false))
      ax(2) = nexttile;
      plot(x,sqrt(sum(pop.V.^2,3)),'.-'); ylabel('|V| [km/s]')
      ax(3) = nexttile;
      plot(x,pop.Tiso,'.-'); ylabel('T [eV]')
      linkaxes(ax,'x')
      if isDate, for a = ax, datetick(a,'x','keeplimits'); end, end
    end

    function ax = plotSlice(obj,it,dims,varargin)
      % PLOTSLICE Marginal view of the fit at one time index it.
      %
      %   gd.plotSlice(it,1[,'K',K])       1D: vx (1), vy (2) or vz (3)
      %   gd.plotSlice(it,[1 2][,'K',K])   2D: contours of the mixture
      %   Companion data adds the particle histogram / scatter.
      %   Options: 'ax', 'maxPoints' (scatter, default 5000).
      p = inputParser;
      addParameter(p,'ax',[]);
      addParameter(p,'col',[]);
      addParameter(p,'maxPoints',5000);
      parse(p,varargin{:});
      ax = p.Results.ax;
      if isempty(ax), ax = gca; end
      if numel(dims) > 2, error('GMDist:dims','dims must have 1 or 2 elements.'), end

      gm = obj.marginal(it,dims,'col',p.Results.col);
      K = gm.NumComponents;
      S = GMDist.fullSigma_(gm);
      hasData = ~isempty(obj.data);
      if hasData
        X = GMDist.getSamples_(obj.data,it);
        X = X(:,dims);
      end
      names = {'v_x','v_y','v_z'};

      nd = numel(dims);
      lo = zeros(1,nd); hi = zeros(1,nd);
      for i = 1:nd
        sd = sqrt(max(S(i,i,:),[],3));
        lo(i) = min(gm.mu(:,i)) - 4*sd;
        hi(i) = max(gm.mu(:,i)) + 4*sd;
        if hasData, lo(i) = min(lo(i),min(X(:,i))); hi(i) = max(hi(i),max(X(:,i))); end
      end

      hold(ax,'on')
      if nd == 1
        x = linspace(lo,hi,400).';
        if hasData
          histogram(ax,X,'Normalization','pdf','EdgeColor','none','FaceAlpha',0.4);
        end
        plot(ax,x,pdf(gm,x),'k','LineWidth',1.5)
        for k = 1:K
          gk = gmdistribution(gm.mu(k,:),S(:,:,k));
          plot(ax,x,gm.ComponentProportion(k)*pdf(gk,x))
        end
        xlabel(ax,[names{dims} ' [km/s]']); ylabel(ax,'pdf')
      else
        [xg,yg] = meshgrid(linspace(lo(1),hi(1),150),linspace(lo(2),hi(2),150));
        z = reshape(pdf(gm,[xg(:) yg(:)]),size(xg));
        if hasData
          idx = randperm(size(X,1),min(size(X,1),p.Results.maxPoints));
          scatter(ax,X(idx,1),X(idx,2),4,[0.6 0.6 0.6],'filled')
        end
        contour(ax,xg,yg,z,'LineWidth',1)
        plot(ax,gm.mu(:,1),gm.mu(:,2),'r+','MarkerSize',10)
        axis(ax,'equal')
        xlabel(ax,[names{dims(1)} ' [km/s]']); ylabel(ax,[names{dims(2)} ' [km/s]'])
      end
      title(ax,sprintf('time index %d, K = %d',it,K))
      hold(ax,'off')
    end
    
    function p = totalCovariance(obj,ksub)
      % TOTAL_COVARIANCE Total weight, mean and covariance of components ksub.
      %
      %   p = gd.total_covariance([ksub])
      %
      %   p is a cell {nT x nK} like gd.gmm. Each element is a struct with
      %     w      total proportion of the components ksub
      %     mu     [1 x 3] mean of their sum
      %     Sigma  [3 x 3] covariance of their sum (within + between)
      %   i.e. the single Gaussian with the same weight, mean and covariance
      %   as those components together (law of total covariance).
      %   ksub defaults to all components. An element is [] where there is no
      %   fit, or where ksub does not fit the number of components K.‚„
      if nargin < 2, ksub = []; end
      p = cell(size(obj.gmm));
      for i = 1:numel(obj.gmm)
        g = obj.gmm{i};
        if isempty(g), continue, end
        k = ksub;
        if isempty(k), k = 1:g.NumComponents; end
        if any(k < 1) || any(k > g.NumComponents) || numel(unique(k)) ~= numel(k)
          continue
        end
        p{i} = GMDist.totalCovariance_(g.ComponentProportion,g.mu,GMDist.fullSigma_(g),k);
      end
    end

    function [err,P,nGroups] = mergeErrPartitions(obj,varargin)
      % MERGEERRPARTITIONS Distance between each fit and its merged versions, for all partitions.
      %
      %   [err,P,nGroups] = gd.mergeErrPartitions([option,value,...])
      %
      %   For every entry of gd.gmm (a fit with K = gd.nComp components) and
      %   every partition of its components 1:K (see allPartitions) the groups
      %   are merged as in merge, and the distance to the original mixture is
      %   computed. The outputs are cells {nT x nC} like gd.gmm, [] where
      %   there is no fit:
      %     err      [1 x nP]  distance of each partition
      %     P        {1 x nP}  the partitions, each a cell of groups
      %     nGroups  [1 x nP]  number of groups in each partition
      %
      %   'metric' sets the distance between the original mixture f and the
      %   merged mixture g:
      %     'l2'  (default) sqrt(int (f-g)^2), closed form:
      %           int N(x;m1,S1) N(x;m2,S2) dx = N(m1-m2; 0, S1+S2).
      %           Dominated by the dense, cold cores.
      %     'l1'  total variation, 1/2 int |f-g|, in [0,1]; Monte Carlo.
      %     'kl'  KL(f||g) in nats per particle, the quantity EM maximizes
      %           (log-likelihood loss); Monte Carlo.
      %   'l1' and 'kl' use 'nSamples' samples (default 20000), the same for
      %   all partitions of an entry, and the random seed 'seed' (default 1,
      %   offset by the entry number; the global random state is restored
      %   afterwards). 'normalized' (default true) applies to 'l2': divide by
      %   sqrt(int f^2); false gives sqrt(int (f-g)^2) in (km/s)^-3.
      %   Other options:
      %     'sort'  'ascend' or 'descend': order the partitions of each entry by err
      %     'K'     only entries with these numbers of components
      %     'maxK'  largest K allowed (default 8): the number of partitions
      %             grows as the Bell number of K
      p = inputParser;
      addParameter(p,'normalized',true);
      addParameter(p,'sort','');
      addParameter(p,'metric','l2');
      addParameter(p,'nSamples',20000);
      addParameter(p,'seed',1);
      addParameter(p,'K',[]);
      addParameter(p,'maxK',8);
      parse(p,varargin{:});
      metric = validatestring(p.Results.metric,{'l2','l1','kl'});
      if ~strcmp(metric,'l2'), s0 = rng; restoreRng = onCleanup(@() rng(s0)); end

      % The partitions depend only on K: compute them once for each K present
      nComp = obj.nComp;
      Ks = unique(nComp(~isnan(nComp)));
      if ~isempty(p.Results.K), Ks = intersect(Ks,p.Results.K); end
      if any(Ks > p.Results.maxK)
        error('GMDist:mergeErr','K = %d gives too many partitions (maxK = %d).',max(Ks),p.Results.maxK)
      end
      AP = GMDist.allPartitionsK(Ks);
      KinP = cellfun(@(x) x.K,AP);

      err = cell(size(obj.gmm));
      P = cell(size(obj.gmm));
      nGroups = cell(size(obj.gmm));
      for igmm = 1:numel(obj.gmm)
        g = obj.gmm{igmm};
        if isempty(g) || ~ismember(g.NumComponents,Ks), continue, end
        Pk = AP{KinP == g.NumComponents};
        uG = Pk.groups;
        iG = Pk.iG;
        nG = numel(uG);
        w = g.ComponentProportion(:).';
        mu = g.mu;
        S = GMDist.fullSigma_(g);

        % One Gaussian per possible group of components
        wG = zeros(1,nG); muG = zeros(nG,3); SG = zeros(3,3,nG);
        for ig = 1:nG
          [wG(ig),muG(ig,:),SG(:,:,ig)] = GMDist.totalCovariance_(w,mu,S,uG{ig});
        end

        errv = zeros(1,numel(Pk.P));
        switch metric
          case 'l2'
            % Inner products: original with itself, with each group, groups with each other
            ff = GMDist.mixInner_(w,mu,S,w,mu,S);
            c = zeros(1,nG);
            M = zeros(nG,nG);
            for a = 1:nG
              c(a) = GMDist.mixInner_(w,mu,S,wG(a),muG(a,:),SG(:,:,a));
              for b = a:nG
                M(a,b) = GMDist.mixInner_(wG(a),muG(a,:),SG(:,:,a),wG(b),muG(b,:),SG(:,:,b));
                M(b,a) = M(a,b);
              end
            end
            % ||f-g||^2 = <f,f> - 2<f,g> + <g,g>, for each partition
            for ip = 1:numel(errv)
              idx = iG{ip};
              d2 = ff - 2*sum(c(idx)) + sum(sum(M(idx,idx)));
              errv(ip) = sqrt(max(d2,0));
            end
            if p.Results.normalized, errv = errv/sqrt(ff); end
          otherwise
            % 'l1' (total variation) and 'kl': Monte Carlo, samples shared by all partitions
            if igmm == 13;
1;
            end
            errv = GMDist.sampledPartitionErr_(metric,w,mu,S,wG,muG,SG,iG,p.Results.nSamples,p.Results.seed+igmm);
        end

        err{igmm} = errv;
        P{igmm} = Pk.P(:).';
        nGroups{igmm} = Pk.nGroups(:).';
        if ~isempty(p.Results.sort)
          [~,iSort] = sort(errv,p.Results.sort);
          err{igmm} = err{igmm}(iSort);
          P{igmm} = P{igmm}(iSort);
          nGroups{igmm} = nGroups{igmm}(iSort);
        end
      end
    end

    function [bestErr,bestP] = mergeErrBest(obj,varargin)
      % MERGEERRBEST Smallest merge distance for each final number of components M.
      %
      %   [bestErr,bestP] = gd.mergeErrBest([option,value,...])
      %
      %   For every entry of gd.gmm with K components and every M = 1:K, the
      %   partition of the K components into M groups with the smallest
      %   distance. Outputs are cells {nT x nC} like gd.gmm, [] where there is
      %   no fit:
      %     bestErr  [1 x K]  bestErr{i}(M) is the distance of the best M-group partition
      %     bestP    {1 x K}  bestP{i}{M} is that partition, a cell of groups
      %   M = K is the unmerged fit (distance 0). Options are those of
      %   mergeErrPartitions ('metric', 'normalized', 'nSamples', 'seed', 'K', 'maxK').
      [err,P,nGroups] = obj.mergeErrPartitions(varargin{:});
      bestErr = cell(size(obj.gmm));
      bestP = cell(size(obj.gmm));
      for igmm = 1:numel(obj.gmm)
        if isempty(err{igmm}), continue, end
        K = obj.gmm{igmm}.NumComponents;
        bestErr{igmm} = nan(1,K);
        bestP{igmm} = cell(1,K);
        for m = 1:K
          idx = find(nGroups{igmm} == m);
          [e,iBest] = min(err{igmm}(idx));
          bestErr{igmm}(m) = e;
          bestP{igmm}{m} = P{igmm}{idx(iBest)};
        end
      end
    end

    function N = nT(obj)
      N = size(obj.gmm,1);
    end
    
    function N = nK(obj)
      N = size(obj.gmm,2);
    end
    
    function m = mass(obj)
      m = obj.mass_;
    end
  end

  methods (Static)
    function obj = fit(data,K,varargin)
      % GMDist.fit Fit Gaussian mixtures to velocity samples.
      %
      %   gd = GMDist.fit(data,K,[option,value,...])
      %
      %   data: one [N x 3] matrix, a {nT x 1} cell of [N x 3] (km/s), or an
      %         object with methods samples(it) and length (e.g. MParts)
      %   K:    vector of component numbers
      %   Options:
      %     'start'  'randSample' (default) or 'previous' (start from the
      %              fit at the previous time step with the same K)
      %     'time','mass'  metadata (taken from the data object if not given)
      %   All other options are passed to FITGMDIST. A failed fit gives a
      %   warning and an empty entry.
      %
      %   Note: the fit is unweighted.
      if isempty(K)
        warning('GMDist:fit','Empty K, setting K = 1.')
        K = 1;
      end
      p = inputParser;
      p.KeepUnmatched = true;
      % Add defaults
      addParameter(p,'start','randSample');
      addParameter(p,'time',[]); 
      addParameter(p,'mass',[]);
      % Parse input
      parse(p,varargin{:});
      start = validatestring(p.Results.start,{'randSample','previous'});
      fitArgs = [fieldnames(p.Unmatched), struct2cell(p.Unmatched)]';
      fitArgs = fitArgs(:)';

      if isnumeric(data), data = {data}; end
      t = []; m = [];
      if iscell(data)
        nT = numel(data);
      else
        GMDist.checkCompanion_(data);
        nT = data.length();
        if isprop(data,'time'), t = data.time; end
        if isprop(data,'mass'), m = data.mass; end
      end
      if ~isempty(p.Results.time), t = p.Results.time; end
      if ~isempty(p.Results.mass), m = p.Results.mass; end

      nK = numel(K);
      out = cell(nT,nK);
      for iK = 1:nK
        ttic = tic;
        fprintf('K = %g (K=[%s]), ',K(iK),num2str(K))
        for it = 1:nT
          X = GMDist.getSamples_(data,it);
          S = 'randSample';
          if strcmp(start,'previous') && it > 1 && ~isempty(out{it-1,iK})
            S = GMDist.startFrom_(out{it-1,iK});
          end
          try
            out{it,iK} = fitgmdist(X,K(iK),'Start',S,fitArgs{:});
          catch ME
            warning('GMDist:fit','Fit failed at time index %d, K = %d: %s',it,K(iK),ME.message)
          end
        end
        fprintf('time elapsed is %g seconds.\n',toc(ttic))
      end
      obj = GMDist(out,'data',data,'time',t,'mass',m, ...
        'options',struct('start',start,'fitgmdist',{fitArgs}));
    end
    
    function  GM = parent_param(obj)
      % Passes parent parameters like counts (and associated error, 
      % perhaps), and depends indices. Depende indices will give an
      % indication of from how many bins the particles of a given GMM comes
      % from. For example, does cold populations only come from one enerrgy
      % bin?
    end
    function AP = allPartitionsK(Ks)
      % ALLPARTITIONSK Partitions for several numbers of components; AP{K} for each K in Ks.
      Ks = unique(Ks(~isnan(Ks)));
      AP = cell(1,numel(Ks));
      for iK = 1:numel(Ks)
        [P,uG,iG] = GMDist.allPartitions(Ks(iK));
        AP{iK} = struct('K',Ks(iK),'P',{P},'groups',{uG},'iG',{iG},'nGroups',cellfun(@numel,P));
      end
    end

    function [P, uniqueGroups, iG_in_P, iG_in_P_mat] = allPartitions(K)
      % Generate all nonempty unique groups
      uniqueGroups = cell(2^K - 1, 1);

      for mask = 1:(2^K - 1)
        group = find(bitget(mask, 1:K));
        uniqueGroups{mask} = group;
      end

      % Generate all partitions recursively
      P = GMDist.recursivePartitions_(K);

      % Determine which unique-group indices belong to each partition
      iG_in_P = cell(size(P));

      % Matrix: one row per partition, one column per element
      iG_in_P_mat = zeros(numel(P), K);

      for p = 1:numel(P)

        partition = P{p};
        groupIndices = zeros(1, numel(partition));

        for j = 1:numel(partition)

          group = sort(partition{j});

          % Convert group to its corresponding bitmask
          mask = sum(2.^(group - 1));

          % The mask is also the index in uniqueGroups
          groupIndices(j) = mask;

          % Assign this group index to all its elements
          iG_in_P_mat(p, group) = mask;
        end

        iG_in_P{p} = groupIndices;
      end
    end

    function varargout = totalCovariance_(w0,mu0,Sigma0,ksub)
      % TOTALCOVARIANCE_ Weight, mean and covariance of the sum of components ksub.
      %
      %   [w,mu,Sigma] = GMDist.totalCovariance_(w0,mu0,Sigma0[,ksub])
      %   s = GMDist.totalCovariance_(...)     struct with fields w, mu, Sigma
      %
      %   w0 [1 x K] (or [K x 1]), mu0 [K x 3], Sigma0 [3 x 3 x K] (full
      %   covariances). ksub: components to include, default all.
      w0 = w0(:).';
      if nargin < 4 || isempty(ksub), ksub = 1:numel(w0); end

      wk = w0(ksub);
      wS = sum(wk);                          % total weight
      muS = (wk*mu0(ksub,:))/wS;             % weighted mean, [1 x 3]

      % Total covariance = within + between
      d = size(mu0,2);
      SigS = zeros(d,d);
      for ii = 1:numel(ksub)
        k = ksub(ii);
        dmu = (mu0(k,:)-muS).';
        SigS = SigS + w0(k)*(Sigma0(:,:,k) + dmu*dmu.');
      end
      SigS = SigS/wS; % This returns NaN is weight if group is zero.
      
      if any(isnan(SigS)); SigS = eye(3,3)*eps; end
      if any(isnan(muS));  muS = [0 0 0]; end

      if nargout <= 1
        out.w = wS;
        out.mu = muS;
        out.Sigma = SigS;
        varargout{1} = out;
      else
        varargout{1} = wS;
        varargout{2} = muS;
        varargout{3} = SigS;
      end
    end
    

  end

  methods (Access = private)
    function t = tsTime_(obj)
      t = obj.time;
      if ~isa(t,'GenericTimeArray')
        error('GMDist:time','The ts* methods and plotReduced need time as a GenericTimeArray.')
      end
    end

    function o = reducedOpts_(obj,dim,args)
      % Shared option handling for tsReduced and plotReduced.
      p = inputParser;
      addParameter(p,'vg',[]);
      addParameter(p,'nv',200);
      addParameter(p,'component',0);
      addParameter(p,'n',[]);
      parse(p,args{:});
      if ~isscalar(dim) || ~ismember(dim,1:3)
        error('GMDist:dims','Only 1D reductions (dim = 1, 2 or 3) are supported for now.')
      end
      o.idx = obj.entryIndex_([]);         % the entry of the (single) column at each time
      noFit = all(isnan(o.idx));
      nC = obj.nComp;
      if noFit, o.K = 0; else, o.K = max(nC(o.idx(~isnan(o.idx)))); end
      vg = p.Results.vg;
      if isempty(vg)
        if noFit
          vg = linspace(-2500,2500,p.Results.nv);   % nothing to take the extent from
        else
          vg = obj.defaultGrid_(o.idx,dim,p.Results.nv);
        end
      end
      o.vg = vg(:).';
      nTot = obj.totalDensity_(p.Results.n);
      o.normalized = all(isnan(nTot));
      if o.normalized, nTot = ones(size(nTot)); end
      o.scale = nTot.*obj.fracAt_(o.idx);     % a sub-mixture carries only its share
      o.component = p.Results.component;
    end

    function vg = defaultGrid_(obj,idx,dim,nv)
      % Velocity grid spanning all fitted means +- 4 sd along dim.
      lo = inf; hi = -inf;
      for it = 1:numel(idx)
        if isnan(idx(it)), continue, end
        g = obj.gmm{idx(it)};
        S = GMDist.fullSigma_(g);
        m = g.mu(:,dim);
        sd = sqrt(reshape(S(dim,dim,:),[],1));
        lo = min(lo,min(m-4*sd));
        hi = max(hi,max(m+4*sd));
      end
      if ~isfinite(lo), error('GMDist:fit','No fits for this K.'), end
      vg = linspace(lo,hi,nv);
    end

    function PD = reducedPD_(obj,t,o,dim,c)
      % One PDist from the sum of the components c (0 = all).
      if ~isequal(c,0) && o.K > 0 && (~isnumeric(c) || isempty(c) || ~all(ismember(c,1:o.K)) || numel(unique(c)) ~= numel(c))
        error('GMDist:component','''component'' must be 0 or distinct numbers in 1:%d.',o.K)
      end
      D = obj.reducedData_(o.idx,dim,o.vg,c,o.scale);
      PD = GMDist.makePDist_(t,D,o.vg);
    end

    function D = reducedData_(obj,idx,dim,vg,comps,scale)
      % [nT x nv] reduced distribution of the selected components (0 = all);
      % components a fit does not have are left out.
      nT = numel(idx);
      D = nan(nT,numel(vg));
      SI_conversion = 1e6*1e-3; % 1e6 for cm^-3 -> m^-3; 1e-3 for 1/km -> 1/m
      for it = 1:nT
        if isnan(idx(it)), continue, end
        g = obj.gmm{idx(it)};
        c = comps;
        if isequal(c,0), c = 1:g.NumComponents; end
        c = c(c <= g.NumComponents);
        if isempty(c), continue, end
        D(it,:) = scale(it)*GMDist.marg1D_(g,dim,vg,c)*SI_conversion;
      end
    end

    function f = fracAt_(obj,idx)
      % Share of the total density carried by the entry idx(it) (linear index
      % into gmm) at each time; 1 where there is no entry.
      f = ones(numel(idx),1);
      ok = ~isnan(idx);
      f(ok) = obj.frac(idx(ok));
    end

    function idx = entryIndex_(obj,K)
      % Linear index into gmm of the entry with K components at each time
      % (K = []: the first non-empty entry), NaN where there is none.
      nC = obj.nComp;
      idx = nan(size(nC,1),1);
      for it = 1:size(nC,1)
        j = GMDist.entryCol_(nC(it,:),K);
        if ~isempty(j), 
          idx(it) = sub2ind(size(nC),it,j); 
        end
      end
    end

    function ie = entryAt_(obj,it,K)
      % Same as entryIndex_ for the single time index it (NaN if none).
      row = cellfun(@GMDist.numComp_,obj.gmm(it,:));
      j = GMDist.entryCol_(row,K);
      ie = NaN;
      if ~isempty(j), ie = sub2ind(size(obj.gmm),it,j); end
    end

    function [B,Ks] = bicByK_(obj)
      % BIC arranged by number of components: B [nT x numel(Ks)], Ks ascending.
      nC = obj.nComp;
      Ks = unique(nC(~isnan(nC))).';
      B = nan(size(nC,1),numel(Ks));
      for j = 1:numel(Ks)
        idx = obj.entryIndex_(Ks(j));
        ok = ~isnan(idx);
        B(ok,j) = obj.bic(idx(ok));
      end
    end

    function out = perColumn_(obj,fcn)
      % Apply fcn to each column of gmm, as a single-column GMDist. One column:
      % its result; several: a cell {1 x nC}.
      nC = size(obj.gmm,2);
      if nC == 1, out = fcn(obj); return, end
      out = cell(1,nC);
      for ic = 1:nC, out{ic} = fcn(obj.slice(':',ic)); end
    end

    function k = nCompOrig_(obj)
      % Number of components of each entry before any merge (misc.nCompOrig),
      % or the present number if the object was not merged.
      if isfield(obj.misc,'nCompOrig') && isequal(size(obj.misc.nCompOrig),size(obj.gmm))
        k = obj.misc.nCompOrig;
      else
        k = obj.nComp;
      end
    end

    function fac = massFactor_(obj)
      % (km/s)^2 -> eV for the particle mass
      u = irf_units;
      m = obj.mass_;
      if isempty(m)
        m = u.mp;
        warning('GMDist:mass','Empty mass, using proton mass.')
      end
      fac = (m/u.eV)*1e6;
    end

    function nTot = totalDensity_(obj,nOpt)
      % Total density [cm^-3] per time: given, from the companion data, or NaN.
      nT = size(obj.gmm,1);
      nTot = nan(nT,1);
      if ~isempty(nOpt)
        if numel(nOpt) ~= nT, error('GMDist:n','n must have %d elements.',nT), end
        nTot = nOpt(:);
      elseif ~isempty(obj.data) && ~iscell(obj.data) && ismethod(obj.data,'n')
        try
          ts = obj.data.n;
          nTot = ts.data(:);
        catch
          % no usable density from the companion (e.g. no weights): NaN
        end
      end
    end

    function [x,isDate] = xTime_(obj)
      % Time axis for plots (falls back to the time index).
      nT = size(obj.gmm,1);
      x = (1:nT).'; isDate = false;
      t = obj.time;
      if isa(t,'GenericTimeArray')
        try
          x = t.toDatenum; x = x(:); isDate = true;
        catch
          % keep the index
        end
      elseif ~isempty(t)
        x = t(:);
      end
    end
  end

  methods (Static, Access = private)
    function PD = skymapPD_(pd,w,mu,sigma,c,K)
      % Evaluate the sum of components c (0 = all) on the template grid.
      if isequal(c,0), c = 1:K; end
      if ~isnumeric(c) || isempty(c) || ~all(ismember(c,1:K)) || numel(unique(c)) ~= numel(c)
        error('GMDist:component','''component'' must be 0 or distinct numbers in 1:%d (K = %d).',K,K)
      end
      PD = pdist_generalized_maxwellian(pd,w(c,:),mu(c,:,:),sigma(:,:,c,:));
    end

    function j = entryCol_(row,K)
      % Column of the first entry in row with K components (K = []: the first non-empty).
      if isempty(K), j = find(~isnan(row),1); else, j = find(row == K,1); end
    end

    function m = metricFromArgs_(args)
      % The 'metric' value in a name-value list (default 'l2').
      m = 'l2';
      for i = 1:2:numel(args)-1
        if ischar(args{i}) && strcmpi(args{i},'metric')
          m = validatestring(args{i+1},{'l2','l1','kl'});
        end
      end
    end

    function lbl = metricLabel_(m)
      switch m
        case 'l2', lbl = 'L2 err';
        case 'l1', lbl = 'L1 err (TV)';
        case 'kl', lbl = 'KL(f||g) [nats]';
      end
    end

    function err = sampledPartitionErr_(metric,w,mu,S,wG,muG,SG,iG,N,seed)
      % Total variation (1/2 int |f-g|) or KL(f||g) between the original
      % mixture f and the merged mixture g of every partition, by Monte Carlo.
      % The same N samples are used for all partitions (common random numbers).
      %   w [1 x K], mu [K x 3], S [3 x 3 x K]   original mixture f
      %   wG [1 x nG], muG [nG x 3], SG [3 x 3 x nG]   one Gaussian per possible group
      %   iG{ip}  indices of the groups making up partition ip
      K = numel(w); nG = numel(wG);
      rng(seed);
      means = [mu; muG];
      covs = cat(3,S,SG);
      switch metric
        case 'kl'   % samples from f
          pis = [w(:).', zeros(1,nG)];
        case 'l1'   % samples from f and from every group Gaussian, so g is covered too
          pis = [0.5*w(:).', 0.5*ones(1,nG)/nG];
      end
      X = GMDist.drawMixture_(pis,means,covs,N);
      Pd = zeros(N,K+nG);
      for c = 1:K+nG
        Pd(:,c) = GMDist.gaussPdf_(X,means(c,:),covs(:,:,c));
      end
      f = Pd(:,1:K)*w(:);               % original mixture at the samples
      G = Pd(:,K+1:end).*wG;            % weighted group Gaussians, N x nG
      err = zeros(1,numel(iG));
      switch metric
        case 'kl'
          for ip = 1:numel(iG)
            g = sum(G(:,iG{ip}),2);
            err(ip) = mean(log(f) - log(g));
          end
        case 'l1'
          q = Pd*(pis(:)/sum(pis));     % sampling density
          for ip = 1:numel(iG)
            g = sum(G(:,iG{ip}),2);
            err(ip) = 0.5*mean(abs(f-g)./q); % the factor 0.5 makes so that it normalizes to 1
          end
      end
      err = max(err,0);
    end

    function X = drawMixture_(pis,means,covs,N)
      % N samples from a Gaussian mixture with weights pis, means [C x d], covs [d x d x C].
      pis = pis(:).'/sum(pis);
      cs = cumsum(pis);
      idx = 1 + sum(rand(N,1) >= cs(1:end-1),2);
      d = size(means,2);                % number of dimensions
      X = zeros(N,d);
      for c = 1:numel(pis)
        ii = find(idx == c);
        if isempty(ii), continue, end
        R = chol(covs(:,:,c));                       % covs = R'R
        X(ii,:) = means(c,:) + randn(numel(ii),d)*R;
      end
    end

    function v = gaussPdf_(X,mu,S)
      % Gaussian pdf at the rows of X.
      R = chol(S);                                   % S = R'R
      y = (X - mu)/R;                                % (x-mu)' S^-1 (x-mu) = ||y||^2
      v = exp(-0.5*sum(y.^2,2))/((2*pi)^(size(X,2)/2)*prod(diag(R)));
    end

    function v = mixInner_(w1,mu1,S1,w2,mu2,S2)
      % Integral of the product of two Gaussian mixtures (closed form).
      % w [1 x n], mu [n x d], S [d x d x n].
      v = 0;
      for i = 1:numel(w1)
        for j = 1:numel(w2)
          dm = (mu1(i,:)-mu2(j,:)).';
          C = S1(:,:,i) + S2(:,:,j);
          v = v + w1(i)*w2(j)*exp(-0.5*(dm.'*(C\dm)))/sqrt((2*pi)^numel(dm)*det(C));
        end
      end
    end

    function f = marg1D_(g,dim,vg,comps)
      % 1D marginal of selected components (weighted by proportion) on vg.
      S = GMDist.fullSigma_(g);
      f = zeros(1,numel(vg));
      for k = comps(:).'
        s2 = S(dim,dim,k);
        % Standard output units of 1D reduced dists are s/m^4, here
        % sqrt(s2) is in km, th density scaling outside is in cm^-3,
        % correct for this outside
        f = f + g.ComponentProportion(k)*exp(-0.5*(vg(:).'-g.mu(k,dim)).^2/s2)/sqrt(2*pi*s2); % 
      end
    end

    function PD = makePDist_(t,D,vg)
      % ASSUMPTION: a PDist of type 'line (reduced)' with a velocity grid
      % [nT x nv]. Adjust here if your PDist wants something else.
      PD = PDist(t,D,'line (reduced)',repmat(vg(:).',size(D,1),1));
    end

    function n = lengthOf_(x)
      if iscell(x) || isnumeric(x), n = numel(x);
      else, n = x.length();
      end
    end

    function checkCompanion_(data)
      if ~(ismethod(data,'samples') && ismethod(data,'length'))
        error('GMDist:data',['Data must be a [N x 3] matrix, a cell of [N x 3], ' ...
          'or an object with methods samples(it) and length (such as MParts).'])
      end
    end

    function n = numComp_(g)
      if isempty(g), n = NaN; else, n = g.NumComponents; end
    end

    function X = getSamples_(data,it)
      if iscell(data), X = data{it};
      else, X = data.samples(it);
      end
    end

    function S = fullSigma_(g)
      % Covariances as 3-D array d x d x k whatever the CovarianceType.
      k = g.NumComponents; d = g.NumVariables;
      S = zeros(d,d,k);
      for ik = 1:k
        if g.SharedCovariance, s = g.Sigma; else, s = g.Sigma(:,:,ik); end
        if strcmp(g.CovarianceType,'diagonal'), s = diag(s); end
        S(:,:,ik) = s;
      end
    end

    function b = ownBIC_(g)
      try, b = g.BIC; catch, b = NaN; end
      if isempty(b), b = NaN; end
    end

    function b = bicFromSamples_(g,X)
      % BIC = -2 logL + nPar log(N), unweighted.
      k = g.NumComponents; d = g.NumVariables;
      logL = sum(log(pdf(g,X)));
      if strcmp(g.CovarianceType,'full'), pc = d*(d+1)/2; else, pc = d; end
      if g.SharedCovariance, nc = pc; else, nc = k*pc; end
      nPar = (k-1) + k*d + nc;
      b = -2*logL + nPar*log(size(X,1));
    end

    function S = startFrom_(gm)
      % Starting struct for FITGMDIST from an earlier fit.
      if any(gm.ComponentProportion == 0)
        S = 'randSample';
      else
        S = struct('mu',gm.mu,'Sigma',gm.Sigma,'ComponentProportion',gm.ComponentProportion);
      end
    end
    
    function P = recursivePartitions_(K)

      if K == 1
        P = {{1}};
        return
      end

      Pprev = GMDist.recursivePartitions_(K-1);
      P = {};

      for i = 1:numel(Pprev)

        partition = Pprev{i};

        % Insert K into each existing group
        for j = 1:numel(partition)

          newPartition = partition;
          newPartition{j} = [newPartition{j}, K];

          P{end+1} = newPartition;
        end

        % Add N as a new singleton group
        P{end+1} = [partition, {[K]}];
      end
    end
    
  end
end