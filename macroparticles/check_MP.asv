it = 20;
pd = pd_mod(it);
MP = pd.macroparticles('nbin',1,'skipzero',0,'v_init','E');
[vx,vy,vz] = pd.v;

%%
% This reproduces the moments calculations from PDist
MP = pd_mod.macroparticles('nbin',1,'skipzero',0,'v_init','E','positioning','center'); 
mmp = macroparticle_moments(MP,times);

% All of these inflates the temperature, there's very little difference
% between them.
MPN_p1 = pd_mod.macroparticles('ntot',1e5,'skipzero',0,'v_init','v'); 
mmpN_p1 = macroparticle_moments(MPN_p1,times);

MPN_p2 = pd_mod.macroparticles('ntot',1e5,'skipzero',0,'v_init','E'); 
mmpN_p2 = macroparticle_moments(MPN_p2,times);

MPN_p3 = pd_mod.macroparticles('ntot',1e5,'skipzero',0,'v_init','v3'); 
mmpN_p3 = macroparticle_moments(MPN_p3,times);

% All of these inflates the temperature, there's very little difference
% between them.
uMPN_p1 = pd_mod_gen_ups.macroparticles('ntot',1e5,'skipzero',0,'v_init','v'); 
ummpN_p1 = macroparticle_moments(uMPN_p1,times);

uMPN_p2 = pd_mod_gen_ups.macroparticles('ntot',1e5,'skipzero',0,'v_init','E'); 
ummpN_p2 = macroparticle_moments(uMPN_p2,times);

uMPN_p3 = pd_mod_gen_ups.macroparticles('ntot',1e5,'skipzero',0,'v_init','v3'); 
ummpN_p3 = macroparticle_moments(uMPN_p3,times);
%irf_plot({t.xx,pd_mod.T.xx,mmp.T.xx,mmpN_p1.T.xx,mmpN_p2.T.xx,mmpN_p3.T.xx},'comp')

