g = GM.gmm{it,iK};
w = g.ComponentProportion;
mu = g.mu;
Sigma = g.Sigma;

labels = [1 2 1 2];
labels = [1 2 2 2];
e = l2err_partition(w, mu, Sigma, labels);

vg = -2500:50:2500;
dim = 3;
