  for iL1 = 1:numel(stats.thrL1)
    steps(hca,eT,N.l1.(where)(:,iL1),'LineWidth',1)
  end
  hold(hca,'off')
  %plot(hca,0.5:1:8,N.pre,1:7,N.post)
  hca.XGrid = 'on';
  hca.YGrid = 'on';
  %hca.XLabel.String = 'T_{min} (eV)';
